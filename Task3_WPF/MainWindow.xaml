<Window x:Class="Task3_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Завдання 3 (Варіант 4)" Height="300" Width="350">
    <StackPanel Margin="15">
        <Label Content="Введіть число x:"/>
        <TextBox x:Name="txtX" Margin="0,0,0,5"/>

        <Label Content="Введіть число y:"/>
        <TextBox x:Name="txtY" Margin="0,0,0,5"/>

        <Label Content="Введіть число z:"/>
        <TextBox x:Name="txtZ" Margin="0,0,0,15"/>

        <Button Content="Обчислити s" Click="BtnCalculate_Click" Padding="5" Margin="0,0,0,15"/>

        <!-- Тут буде виводитись результат або текст помилки -->
        <TextBlock x:Name="txtResult" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
    </StackPanel>
</Window>